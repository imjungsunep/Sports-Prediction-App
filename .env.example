# ─────────────────────────────────────────────────────────────────────────────
# Sports Match Predictor — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Groq inference API key (required)
# Obtain from: https://console.groq.com/keys
# If the key below has been exposed, rotate it immediately — see README §Security.
GROQ_API_KEY=

# Groq model to use (optional, default: llama3-8b-8192)
GROQ_MODEL=llama3-8b-8192

# HTTP port for the Express server (optional, default: 3000)
PORT=3000

# ─── Optional: Live data integration ─────────────────────────────────────────
# If set, the retrieval service will attempt live fixture lookups via API-Football.
# Leave blank to run in fully local/historical mode (recommended for demos).
# Obtain from: https://www.api-football.com/
# FOOTBALL_API_KEY=

# ─── Database path (optional, default: ./data/football.db) ───────────────────
# DB_PATH=./data/football.db
